{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark results",
  "description": "One benchmark of one model on one device and backend. Written by eval/ on computers and by apps/ on phones. Holds raw measurements only: averages and tables are computed from these files later.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp", "device", "engine", "model", "settings", "reliability", "load_times_s", "peak_memory", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "timestamp": {
      "type": "string",
      "description": "When the benchmark started, in UTC, e.g. 2026-11-04T12:00:00Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "notes": { "type": "string", "description": "Anything unusual about this run." },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform", "os", "chip", "ram_gb"],
      "properties": {
        "name": { "type": "string", "description": "e.g. iPhone 13 Pro Max" },
        "platform": { "enum": ["linux", "macos", "ios", "android"] },
        "os": { "type": "string", "description": "e.g. iOS 18.1" },
        "chip": { "type": "string", "description": "e.g. Apple A15 Bionic" },
        "ram_gb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llama_cpp_tag", "llama_cpp_commit", "backend", "gpu_layers"],
      "properties": {
        "llama_cpp_tag": { "type": "string" },
        "llama_cpp_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "backend": { "enum": ["cpu", "cuda", "metal", "vulkan", "opencl"] },
        "gpu_layers": { "type": "string", "description": "'all', or a number of layers as text, e.g. '0'." },
        "threads": { "type": "integer", "minimum": 1, "description": "CPU threads, if set explicitly." }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "file", "quant", "size_bytes", "sha256", "finetuned"],
      "properties": {
        "key": { "type": "string", "description": "Key in models/registry.yaml, e.g. qwen3.5-2b." },
        "file": { "type": "string" },
        "quant": { "type": "string", "description": "e.g. Q4_K_M" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "finetuned": { "type": "boolean" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ctx_size", "max_tokens", "temperature", "seed", "thinking", "prompts_version", "repeats"],
      "properties": {
        "ctx_size": { "type": "integer", "minimum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer" },
        "thinking": { "type": "boolean" },
        "prompts_version": { "type": "integer", "description": "The version field of spec/bench_prompts.json." },
        "repeats": { "type": "integer", "minimum": 1, "description": "How many times the whole prompt set was requested." }
      }
    },
    "reliability": {
      "type": "object",
      "description": "The Phase 1 pass/fail criterion: did every requested run finish without the app or server dying?",
      "additionalProperties": false,
      "required": ["runs_requested", "runs_completed", "error"],
      "properties": {
        "runs_requested": { "type": "integer", "minimum": 1 },
        "runs_completed": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"], "description": "What stopped the benchmark, or null if nothing did." }
      }
    },
    "load_times_s": {
      "type": "array",
      "description": "Seconds to load the model, once per load. Empty if the model never loaded.",
      "items": { "type": "number", "minimum": 0 }
    },
    "peak_memory": {
      "type": "object",
      "description": "Highest memory use of the process. Methods differ per platform, so the method is recorded.",
      "additionalProperties": false,
      "required": ["bytes", "method"],
      "properties": {
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "method": { "type": ["string", "null"], "description": "e.g. VmHWM on Linux, phys_footprint on iOS." },
        "gpu_bytes": { "type": "integer", "minimum": 0, "description": "Separate GPU memory, where it can be measured." }
      }
    },
    "thermal": {
      "type": "object",
      "description": "Device temperature state, on devices that report one.",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "description": "e.g. nominal, fair, serious, critical" },
        "end": { "type": "string" }
      }
    },
    "runs": {
      "type": "array",
      "description": "One entry per completed prompt.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt_id", "repeat", "prompt_tokens", "reply_tokens", "finish_reason", "time_to_first_token_ms", "prompt_tokens_per_s", "reply_tokens_per_s", "total_ms"],
        "properties": {
          "prompt_id": { "type": "string", "description": "id in spec/bench_prompts.json." },
          "repeat": { "type": "integer", "minimum": 0, "description": "Which repeat of the prompt set, from 0." },
          "prompt_tokens": { "type": "integer", "minimum": 0 },
          "reply_tokens": { "type": "integer", "minimum": 0 },
          "finish_reason": { "type": "string", "description": "stop if the model finished, length if it hit max_tokens." },
          "time_to_first_token_ms": { "type": "number", "minimum": 0 },
          "prompt_tokens_per_s": { "type": "number", "minimum": 0 },
          "reply_tokens_per_s": { "type": "number", "minimum": 0 },
          "total_ms": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
