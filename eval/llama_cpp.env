# Pinned llama.cpp version used by every benchmark in this repo.
#
# llama.cpp publishes several releases a day; pinning one means every machine
# (and later the phone apps) runs the same inference engine. To upgrade, change
# both values to another release from
# https://github.com/ggml-org/llama.cpp/releases and re-run build_llama_cpp.sh.

LLAMA_CPP_TAG=b12078
LLAMA_CPP_COMMIT=19e8a86fe87e5888f61b3aa975e8634b322bd776
